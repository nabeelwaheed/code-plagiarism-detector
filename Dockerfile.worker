FROM rust:1.86-bookworm AS engine-builder
WORKDIR /app

COPY engine ./engine
RUN cargo build --manifest-path engine/Cargo.toml --release

FROM node:22-bookworm-slim AS builder
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY prisma ./prisma
COPY packages ./packages
COPY apps ./apps

RUN npm ci
RUN npm run prisma:generate
RUN npm run build --workspace @similarity/shared
RUN npm run build --workspace @similarity/worker

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV ENGINE_BINARY_PATH=/app/bin/engine-cli

COPY --from=builder /app/package.json /app/package-lock.json /app/tsconfig.base.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps ./apps
COPY --from=engine-builder /app/engine/target/release/engine-cli /app/bin/engine-cli

CMD ["npm", "run", "start", "--workspace", "@similarity/worker"]
