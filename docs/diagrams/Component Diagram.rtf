\f0\fs24 \cf0 @startuml\
title Component Diagram\
\
\
skinparam linetype ortho\
skinparam shadowing false\
skinparam nodesep 25\
skinparam ranksep 100\
\
package "Client" \{\
  [Web UI] as UI\
\}\
\
package "Backend" \{\
  [Backend API] as API\
  [Auth/RBAC] as AUTH\
  [Course/Offering Service] as COURSE\
  [Assignment Service] as ASSIGN\
  [Submission Service] as SUB\
  [Template Service] as TEMP\
  [Repository Service] as REPO\
  [Analysis Job Service] as JOB\
  [Results Service] as RES\
  [Notification Service] as NOTIF\
\}\
\
package "Analysis" \{\
  [Analysis Worker] as WORKER\
  [Similarity Engine] as ENGINE\
  [Evidence Generator] as EVID\
\}\
\
database "Metadata DB\\n(PostgreSQL)" as DB\
cloud "Storage\\n(Filesystem / S3-like)" as STORE\
queue "Job Queue / Job Table" as Q\
component "Email Service (optional)" as EMAIL\
\
UI --> API : HTTPS/REST\
\
API --> AUTH\
API --> COURSE\
API --> ASSIGN\
API --> SUB\
API --> TEMP\
API --> REPO\
API --> JOB\
API --> RES\
API --> NOTIF\
\
COURSE --> DB\
ASSIGN --> DB\
SUB --> DB\
TEMP --> DB\
REPO --> DB\
JOB --> DB\
RES --> DB\
NOTIF --> DB\
\
' Keep arrows short; details go in notes\
SUB --> STORE : files\
TEMP --> STORE : files\
REPO --> STORE : files (opt)\
\
JOB --> Q : enqueue\
WORKER --> Q : dequeue\
\
WORKER --> STORE : load inputs\
WORKER --> ENGINE : similarity\
ENGINE --> EVID : evidence\
WORKER --> DB : persist outputs\
\
NOTIF --> EMAIL : send (opt)\
\
note left of STORE\
Storage contains:\
- submissions\
- templates\
end note\
\
note bottom of DB\
Metadata DB stores:\
- courses / offerings\
- assignments\
- submission metadata\
- jobs + status\
- results + evidence references\
end note\
\
note right of Q\
Queue/Job table used to\
dispatch analysis work\
from JOB -> WORKER.\
end note\
\
@enduml\
