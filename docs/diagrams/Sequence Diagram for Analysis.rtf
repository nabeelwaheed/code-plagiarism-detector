\f0\fs24 \cf0 @startuml\
title Sequence Diagram - Run Analysis Job\
\
actor Instructor\
boundary UI as "Web UI"\
control API as "Backend API"\
database DB as "Metadata DB"\
queue Q as "Job Queue / Job Table"\
control WORKER as "Engine/Analysis Worker"\
collections STORE as "Object Storage"\
\
Instructor -> UI : Click "Run Analysis"\
UI -> API : POST /analysis/run\
API -> API : Validate RBAC + config\
API -> DB : Create AnalysisJob (QUEUED)\
API -> Q : Enqueue jobId\
API --> UI : jobId + QUEUED\
\
WORKER -> Q : Dequeue jobId\
WORKER -> DB : Set job RUNNING\
WORKER -> STORE : Load submissions + templates\
WORKER -> WORKER : Preprocess + subtract template\
WORKER -> WORKER : Compare + compute evidence\
WORKER -> DB : Persist results + set COMPLETED\
\
UI -> API : GET /analysis/\{jobId\} (poll)\
API -> DB : Read job status\
API --> UI : COMPLETED\
UI --> Instructor : Results available\
\
@enduml\
