# Shared
NODE_ENV=development

# Database / Queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/similarity_app?schema=public
REDIS_URL=redis://localhost:6379

# API
API_HOST=0.0.0.0
API_PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000
UPLOAD_MAX_FILE_SIZE_MB=250

# Auth / Session
AUTH_SESSION_COOKIE_NAME=similarity_session
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
PUBLIC_UPLOAD_STATUS_TOKEN_SECRET=
SUBMISSION_IDENTITY_KEY_ID=
SUBMISSION_IDENTITY_PUBLIC_KEY_PEM_BASE64=
SUBMISSION_IDENTITY_PRIVATE_KEY_PEM_BASE64=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Engine / Worker
ENGINE_BINARY_PATH=
ENGINE_VERSION=0.1.0
ENGINE_GST_MIN_MATCH_LENGTH=8
ENGINE_MINIMUM_COMMENT_LENGTH=12
WORKER_UPLOAD_CONCURRENCY=2
WORKER_COMPARISON_CONCURRENCY=1

# Archive / Storage
OBJECT_STORAGE_MODE=filesystem
OBJECT_STORAGE_ROOT=./var/object-storage
ARCHIVE_MAX_DEPTH=8
ARCHIVE_MAX_SOURCE_FILES=2000
ARCHIVE_MAX_EXPANDED_BYTES=52428800

# Production bootstrap
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
